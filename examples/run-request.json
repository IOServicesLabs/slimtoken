{
  "objective": "Review the scheduler and propose focused correctness fixes",
  "steering": [
    "Prefer actionable findings over general advice",
    "Keep the final response concise"
  ],
  "max_tasks": 32,
  "plan_only": false,
  "scheduler": {
    "max_concurrency": 64,
    "max_retries": 2,
