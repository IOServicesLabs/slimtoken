{
  "name": "slimtoken-review",
  "version": "0.1.0",
  "description": "Review sidecar for the SlimToken engine: zero-token lint gate (cargo clippy / cargo check / node --check) over generated source trees, with report.md and review.json judge output.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slimtoken-review": "bin/slimtoken-review.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "fixtures/",
    "test/",
    "README.md"
  ],
  "scripts": {
    "selftest": "node test/selftest.mjs"
  },
  "keywords": [
    "slimtoken",
    "lint",
    "clippy",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/IOServicesLabs/slimtoken.git",
    "directory": "sidecars/review"
  }
}
